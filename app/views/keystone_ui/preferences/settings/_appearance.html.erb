<%
  choice = KeystoneUi::Preferences::LayoutChoice.new(person: person, account: account, component_key: "colours")
  configuration = KeystoneUi::Preferences.configuration
  chooses_colours = configuration.account_colors && choice.members_choose?
  appearance = KeystoneUi::Preferences::AppearanceChoice.new(person: person, account: account)
  drawn = appearance.colours
  saved = KeystoneUi::Preferences::ComponentPreference.find_by(owner: person, component_key: "colours")&.value || { "template_name" => "default" }
  saved_look = KeystoneUi::Preferences::ComponentPreference.find_by(owner: person, component_key: "look")&.value.to_h["look"]
%>

<% if configuration.account_colors && !choice.members_choose? %>
  <%= ui_alert(message: "Your account sets the colours for everyone.") %>
<% end %>

<% editor = capture do %>
  <%= ui_panel(padding: :lg) do %>
    <%= form_with(url: submit_url, method: :patch, data: { turbo: false }) do %>
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        <% if chooses_colours %>
          <%= render partial: "keystone_ui/preferences/settings/colour_choices", locals: { saved: saved, drawn: drawn, pastes: true, presets: true } %>
        <% end %>

        <% if appearance.person_chooses_look? && KeystoneUi.configuration.looks.any? %>
          <%= render partial: "keystone_ui/preferences/settings/look_choices", locals: { saved_look: saved_look } %>
        <% end %>

        <%= ui_section(title: "Mode", spacing: :sm) do %>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <% KeystoneUi::ThemeChoice::MODES.each do |mode| %>
              <% next if mode == "custom" && !(chooses_colours || appearance.custom_offered?) %>
              <%= ui_radio_card(name: "mode", value: mode, label: mode.capitalize, checked: appearance.mode == mode) %>
            <% end %>
          </div>
        <% end %>

        <% if chooses_colours %>
          <%= render partial: "keystone_ui/preferences/settings/theme_settings", locals: { saved: saved, sent_theme: (local_assigns[:selection].to_h[:theme] unless request.get?) } %>
        <% end %>

        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <%= ui_button(label: "Save", type: :submit) %>
          <% if chooses_colours %>
            <%= ui_button(label: "Reset", variant: :secondary, type: :button, data: { action: "keystone-ui--preferences--appearance-editor#reset" }) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render partial: "keystone_ui/preferences/settings/editor_layout", locals: { editor: editor, previews: chooses_colours } %>
