<%
  configuration = KeystoneUi::Preferences.configuration
  palette_hex = ->(colour, palette) { colour.to_s.start_with?("#") ? colour.to_s : palette.call(colour)[500] }
  templates = { "default" => { accent: configuration.default_accent, surface: configuration.default_surface, text: configuration.default_text, label: "Default" } }
  KeystoneUi::Looks::Templates.all.each { |name, template| templates[name.to_s] = template }
%>

<%= ui_panel(padding: :lg) do %>
  <%= form_with(url: submit_url, method: :patch) do %>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <%= ui_section(title: "Theme", spacing: :sm) do %>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <% templates.each do |name, template| %>
            <% accent_hex = palette_hex.call(template[:accent], KeystoneUi::Looks::Palettes.method(:accent)) %>
            <% surface_hex = palette_hex.call(template[:surface], KeystoneUi::Looks::Palettes.method(:surface)) %>
            <%= ui_option_card(name: "template_name", value: name) do %>
              <span style="display: inline-block; width: 1rem; height: 1rem; border-radius: 9999px; background-color: <%= accent_hex %>;"></span>
              <span style="display: inline-block; width: 1rem; height: 1rem; border-radius: 0.25rem; background-color: <%= surface_hex %>;"></span>
              <span><%= template[:label] %></span>
            <% end %>
          <% end %>
          <%= ui_option_card(name: "template_name", value: "") do %>
            <span>Custom</span>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= ui_button(label: "Save", type: :submit) %>
      </div>
    </div>
  <% end %>
<% end %>
