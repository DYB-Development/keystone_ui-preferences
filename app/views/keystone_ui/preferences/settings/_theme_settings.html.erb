<% roles = KeystoneUi::Preferences::ThemeRoles::ROLES.to_h { |name, role| [ name, role.merge(hover: KeystoneUi::Preferences::ThemeCss::HOVERS[name]).compact ] } %>
<div data-controller="keystone-ui--preferences--theme-editor" data-action="change->keystone-ui--preferences--theme-editor#apply input->keystone-ui--preferences--theme-editor#apply" data-theme-roles="<%= roles.to_json %>">
<%= ui_disclosure do |disclosure| %>
  <% disclosure.with_summary { "Change each theme setting" } %>
  <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
    <% KeystoneUi::Preferences::ThemeRoles::ROLES.each do |name, role| %>
      <% (role[:kind] == :colour ? %w[light dark] : %w[light]).each do |side| %>
        <% field_name = "theme[#{name}][#{side}]" %>
        <% value = theme.dig(name, side).to_s %>
        <% label = role[:kind] == :colour ? "--#{name}, #{side}" : "--#{name}" %>
        <% if %i[colour shadow_colour].include?(role[:kind]) %>
          <%= ui_color_picker(name: field_name, value: value, label: label) %>
        <% else %>
          <% field_id = "#{local_assigns.fetch(:id_prefix, "appearance")}-#{field_name.parameterize}" %>
          <div class="<%= Keystone::Ui::FormFieldComponent::WRAPPER_CLASSES %>">
            <%= label_tag field_id, label, class: Keystone::Ui::FormFieldComponent::LABEL_CLASSES %>
            <%= text_field_tag field_name, value, id: field_id, class: Keystone::Ui::InputComponent::BASE_CLASSES %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
</div>
