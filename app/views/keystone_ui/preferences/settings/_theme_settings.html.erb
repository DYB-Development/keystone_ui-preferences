<% saved_preset = KeystoneUi::Looks::Themes.all.find { |name, _preset| name.to_s == saved["preset_name"] }&.last %>
<% theme = saved_preset ? saved_preset[:theme] : saved["theme"].to_h %>
<% shown = local_assigns[:sent_theme] || theme %>
<% check = KeystoneUi::Preferences::CheckedTheme.new(local_assigns[:sent_paste].present? ? {} : local_assigns[:sent_theme].to_h) %>
<% id_prefix = local_assigns.fetch(:id_prefix, "appearance") %>
<% fonts_id = "#{id_prefix}-theme-fonts" %>
<% roles = KeystoneUi::Preferences::ThemeRoles::ROLES.to_h { |name, role| [ name, role.merge(hover: KeystoneUi::Preferences::ThemeCss::HOVERS[name]).compact ] } %>
<div data-action="change->keystone-ui--preferences--appearance-editor#apply input->keystone-ui--preferences--appearance-editor#apply" data-theme-roles="<%= roles.to_json %>" data-saved-theme="<%= theme.to_json %>" style="display: flex; flex-direction: column; gap: 2rem;">
  <% KeystoneUi::Preferences::ThemeRoles::GROUPS.each do |group, sets| %>
    <%= ui_disclosure do |disclosure| %>
      <% disclosure.with_summary do %><h2 class="<%= Keystone::Ui::SectionComponent::TITLE_CLASSES %>"><%= group %></h2><% end %>
      <div style="display: flex; flex-direction: column; gap: 1.5rem; padding-top: 1rem;">
      <% sets.each do |set, names| %>
        <fieldset style="border: 0; padding: 0; margin: 0; min-width: 0;">
          <legend class="<%= Keystone::Ui::FormFieldComponent::LABEL_CLASSES %>"><%= set %></legend>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
            <% names.each do |name| %>
              <% role = KeystoneUi::Preferences::ThemeRoles::ROLES.fetch(name) %>
              <% if role[:kind] == :colour %><div role="group" aria-label="--<%= name %>" style="display: flex; flex-wrap: wrap; gap: 1rem;"><% end %>
              <% (role[:kind] == :colour ? %w[light dark] : %w[light]).each do |side| %>
                <% field_name = "theme[#{name}][#{side}]" %>
                <% value = shown.dig(name, side).to_s %>
                <% label = role[:kind] == :colour ? "--#{name}, #{side}" : "--#{name}" %>
                <% if %i[colour shadow_colour].include?(role[:kind]) && (value.empty? || value.match?(KeystoneUi::Preferences::CheckedTheme::COLOUR)) %>
                  <%= ui_color_picker(name: field_name, value: value, label: label) %>
                <% else %>
                  <% field_id = "#{id_prefix}-#{field_name.parameterize}" %>
                  <div class="<%= Keystone::Ui::FormFieldComponent::WRAPPER_CLASSES %>">
                    <%= label_tag field_id, label, class: Keystone::Ui::FormFieldComponent::LABEL_CLASSES %>
                    <%= text_field_tag field_name, value, id: field_id, class: Keystone::Ui::InputComponent::BASE_CLASSES, list: (fonts_id if role[:kind] == :font_list) %>
                  </div>
                <% end %>
              <% end %>
              <% if name == check.failing_setting %>
                <p class="<%= Keystone::Ui::FormFieldComponent::ERROR_CLASSES %>"><%= check.refusal.message %></p>
              <% end %>
              <% if role[:kind] == :colour %></div><% end %>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      </div>
    <% end %>
  <% end %>
  <div class="<%= Keystone::Ui::FormFieldComponent::WRAPPER_CLASSES %>">
    <%= label_tag "#{id_prefix}-theme-export", "Export", class: Keystone::Ui::FormFieldComponent::LABEL_CLASSES %>
    <%= content_tag :textarea, nil, id: "#{id_prefix}-theme-export", readonly: true, rows: 8, class: Keystone::Ui::TextareaComponent::BASE_CLASSES, data: { theme_export: "" } %>
    <div><%= ui_copy_button(text: "", error_message: "Select the text to copy it") %></div>
  </div>
  <datalist id="<%= fonts_id %>">
    <% (KeystoneUi::Preferences.configuration.theme_fonts + KeystoneUi::Preferences::CheckedTheme::SYSTEM_FONTS).each do |font| %>
      <option value="<%= font %>"></option>
    <% end %>
  </datalist>
</div>
