<%
  colours = KeystoneUi::Preferences::ComponentPreference.find_by(owner: account, component_key: "colours")
  saved = colours&.value.presence || { "template_name" => "default" }
  look = KeystoneUi::Preferences::ComponentPreference.find_by(owner: account, component_key: "look")
  offers_colours = KeystoneUi::Preferences.configuration.account_colors
  offers_look = KeystoneUi::Preferences.configuration.account_looks && KeystoneUi.configuration.looks.any?
  drawn = KeystoneUi::Preferences::AppearanceChoice.new(person: account, account: nil).colours
%>

<% if !offers_colours && !offers_look %>
  <%= ui_alert(message: "This app does not let accounts choose their colours or look.") %>
<% else %>
<% editor = capture do %>
<%= ui_panel(padding: :lg) do %>
  <%= form_with(url: submit_url, method: :patch, data: { turbo: false }) do %>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <% if offers_colours %>
        <%= render partial: "keystone_ui/preferences/settings/colour_choices", locals: { saved: saved, drawn: drawn, pastes: true, presets: true, own_theme_hint: "The account's current choice is its own theme.", id_prefix: "account-appearance" } %>
      <% end %>

      <% if offers_look %>
        <%= render partial: "keystone_ui/preferences/settings/look_choices", locals: { saved_look: look&.value.to_h["look"] } %>
      <% end %>

      <%= ui_section(title: "Members", spacing: :sm) do %>
        <% if offers_colours %>
          <%= hidden_field_tag "members_choose", "0", id: nil %>
          <%= ui_checkbox_row(name: "members_choose", value: "1", label: "Members choose their own colours", checked: colours.nil? || colours.members_choose) %>
        <% end %>
        <% if offers_look %>
          <%= hidden_field_tag "members_choose_look", "0", id: nil %>
          <%= ui_checkbox_row(name: "members_choose_look", value: "1", label: "Members choose their own look", checked: look.nil? || look.members_choose) %>
        <% end %>
      <% end %>

      <% if offers_colours %>
        <%= render partial: "keystone_ui/preferences/settings/theme_settings", locals: { saved: saved, id_prefix: "account-appearance" } %>
      <% end %>

      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <%= ui_button(label: "Save", type: :submit) %>
        <% if offers_colours %>
          <%= ui_button(label: "Reset", variant: :secondary, type: :button, data: { action: "keystone-ui--preferences--appearance-editor#reset" }) %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
<% end %>

<%= render partial: "keystone_ui/preferences/settings/editor_layout", locals: { editor: editor, previews: offers_colours } %>
<% end %>
