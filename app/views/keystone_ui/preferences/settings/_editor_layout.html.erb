<div data-appearance-editor data-controller="keystone-ui--preferences--appearance-editor" data-action="tab-switcher:change->keystone-ui--preferences--appearance-editor#showPanel submit->keystone-ui--preferences--appearance-editor#save turbo:before-visit@document->keystone-ui--preferences--appearance-editor#confirmLeave beforeunload@window->keystone-ui--preferences--appearance-editor#warnBeforeUnload">
  <% if previews %>
    <style>
      [data-editor-panel]:not([data-shown]) { display: none; }
      @media (min-width: 64rem) {
        [data-appearance-editor] .ks-tab-bar { display: none; }
        [data-editor-panels] { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 1.5rem; align-items: start; }
        [data-editor-panel]:not([data-shown]) { display: block; }
      }
    </style>
    <%= ui_tab_switcher(tabs: %w[Edit Preview]) do %>
      <div data-editor-panels>
        <div data-editor-panel data-shown><%= editor %></div>
        <div data-editor-panel><%= render partial: "keystone_ui/preferences/settings/theme_preview" %></div>
      </div>
    <% end %>
    <div data-leave-question>
      <%= ui_modal(title: "Leave without saving?", size: :sm) do %>
        <p>Your theme changes are not saved yet.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
          <%= ui_button(label: "Leave without saving", variant: :danger, type: :button, data: { action: "keystone-ui--preferences--appearance-editor#leave" }) %>
          <%= ui_button(label: "Stay", variant: :secondary, type: :button, data: { action: "modal#close" }) %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= editor %>
  <% end %>
</div>
