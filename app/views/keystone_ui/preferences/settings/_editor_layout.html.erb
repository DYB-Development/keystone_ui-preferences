<div data-appearance-editor data-controller="keystone-ui--preferences--theme-settings" data-action="tab-switcher:change->keystone-ui--preferences--theme-settings#showPanel">
  <% if previews %>
    <style>
      [data-editor-panel]:not([data-shown]) { display: none; }
      @media (min-width: 64rem) {
        [data-appearance-editor] .ks-tab-bar { display: none; }
        [data-editor-panels] { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 1.5rem; align-items: start; }
        [data-editor-panel]:not([data-shown]) { display: block; }
      }
    </style>
    <%= ui_tab_switcher(tabs: %w[Edit Preview]) do %>
      <div data-editor-panels>
        <div data-editor-panel data-shown><%= editor %></div>
        <div data-editor-panel><%= render partial: "keystone_ui/preferences/settings/theme_preview" %></div>
      </div>
    <% end %>
  <% else %>
    <%= editor %>
  <% end %>
</div>
