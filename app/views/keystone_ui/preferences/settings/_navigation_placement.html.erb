<% choice = KeystoneUi::Preferences::LayoutChoice.new(person: person, account: account, component_key: "navigation") %>
<% current = choice.value&.dig("placement") || "top" %>

<% if choice.members_choose? %>
  <%= form_with(url: submit_url, method: :patch, data: { turbo: false }) do %>
    <%= ui_grid(cols: { default: 1, sm: 3 }, gap: :sm) do %>
      <% { "top" => "Top", "left" => "Left", "right" => "Right" }.each do |placement, label| %>
        <%= ui_radio_card(name: "placement", value: placement, label: label, checked: placement == current) %>
      <% end %>
    <% end %>
    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>
<% else %>
  <%= ui_alert(message: "Your account sets the navigation for everyone.") %>
<% end %>
