<div data-theme-preview style="display: flex; flex-direction: column; gap: 1.5rem;">
  <% %w[light dark].each do |side| %>
    <div data-theme="<%= side %>">
      <%= ui_panel do %>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <%= ui_card(title: "Quarterly review", summary: "Revenue grew in every region this quarter.", link: "#", cta: "Open") %>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <%= ui_button(label: "Save", type: :button) %>
            <%= ui_button(label: "Cancel", variant: :secondary, type: :button) %>
            <%= ui_button(label: "Delete", variant: :danger, type: :button) %>
          </div>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <%= ui_form_field(attribute: "preview_name", label: "Name", value: "Northwind Traders") %>
            <%= ui_form_field(attribute: "preview_region", label: "Region", type: :select, options: [ [ "North", "north" ], [ "South", "south" ] ], value: "north", required: true) %>
          </div>
          <%= ui_data_table(
                items: [ { customer: "Northwind Traders", region: "North", total: "$12,400" }, { customer: "Harbor Supply", region: "South", total: "$8,950" }, { customer: "Fern & Co", region: "North", total: "$4,120" } ],
                columns: [ { customer: "Customer" }, { region: "Region" }, { total: "Total" } ]
              ) %>
          <%= ui_line_chart(
                labels: %w[Jan Feb Mar Apr May Jun],
                series: [ { name: "This year", data: [ 12, 19, 15, 24, 22, 30 ] }, { name: "Last year", data: [ 10, 14, 13, 17, 19, 21 ] } ],
                height: :sm
              ) %>
          <nav class="ks-sidebar" aria-label="Sample navigation">
            <% [ "Dashboard", "Customers", "Reports" ].each_with_index do |label, index| %>
              <a href="#" class="<%= [ Keystone::Ui::NavigationComponent::SIDEBAR_TAB_CLASSES, (Keystone::Ui::NavigationComponent::ACTIVE_CLASS if index.zero?) ].compact.join(" ") %>"><%= label %></a>
            <% end %>
        </nav>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
