<div data-theme-preview>
  <%= ui_card(title: "Quarterly review", summary: "Revenue grew in every region this quarter.", link: "#", cta: "Open") %>
  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
    <%= ui_button(label: "Save", type: :button) %>
    <%= ui_button(label: "Cancel", variant: :secondary, type: :button) %>
    <%= ui_button(label: "Delete", variant: :danger, type: :button) %>
  </div>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <%= ui_form_field(attribute: "preview_name", label: "Name", value: "Northwind Traders") %>
    <%= ui_form_field(attribute: "preview_region", label: "Region", type: :select, options: [ [ "North", "north" ], [ "South", "south" ] ], value: "north", required: true) %>
  </div>
</div>
